# Salin ke .env untuk uji lokal (vercel dev). Di Vercel isi lewat Settings > Environment Variables.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SESSION_SECRET=isi-dengan-string-acak-minimal-32-karakter
GEMINI_API_KEY=isi-api-key-gemini-BARU
GEMINI_MODEL=gemini-3.6-flash
# Opsional: untuk email "Lupa password" (resend.com)
RESEND_API_KEY=
MAIL_FROM=
APP_NAME=DeepMentor AI
